amends "package://github.com/jdx/hk/releases/download/v1.50.0/hk@1.50.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.50.0/hk@1.50.0#/Builtins.pkl"

exclude = List(
  "build",
  ".cache",
  ".conan2",
  ".ruff_cache",
  ".venv",
  ".zig-cache",
  "vendor",
)

local cppFiles = List(
  "apps/**/*.cpp",
  "include/**/*.hpp",
  "src/**/*.hpp",
  "src/**/*.cpp",
  "tests/**/*.cpp",
  "benchmarks/**/*.cpp",
)

local cppSources = List(
  "apps/**/*.cpp",
  "src/**/*.cpp",
  "tests/**/*.cpp",
  "benchmarks/**/*.cpp",
)

local clangdFiles = List(
  "apps/**/*.cpp",
  "include/**/*.hpp",
  "src/**/*.hpp",
  "src/**/*.cpp",
)

local pythonImpact = List(
  "bench",
  "benchmarks/**/*.py",
  "extensions/**/*.py",
  "scripts/**/*.py",
  "scripts/dev-run",
  "test",
  "tests/**/*.py",
  "tools/**/*.py",
  "conanfile.py",
  "pyproject.toml",
  "uv.lock",
  "scripts/ci/python",
)

local buildImpact = List(
  ".gitmodules",
  "apps/**/*.cpp",
  "include/**/*.hpp",
  "src/**/*.hpp",
  "src/**/*.cpp",
  "tests/**/*.cpp",
  "benchmarks/**/*.cpp",
  "CMakeLists.txt",
  "CMakePresets.json",
  "cmake/**",
  "conan/**",
  "conan.lock",
  "conanfile.py",
  "flake.nix",
  "flake.lock",
  "third_party/ghostty",
)

local ciImpact = List(
  ".github/workflows/**",
  "scripts/ci/**",
  "tools/test_ci_changes.py",
)

local hygiene = new Mapping<String, Step | Group> {
  ["merge-conflict"] = Builtins.check_merge_conflict
  ["private-key"] = Builtins.detect_private_key
  // The hk builtin reads worktree paths even for `--staged`; inspect the index when a path has a
  // staged change so unstaged content cannot change the commit decision.
  ["large-file"] {
    check = "python3 scripts/ci/check-file-size.py {{files}}"
  }
  ["case-conflict"] = Builtins.check_case_conflict
  ["executable-shebang"] = Builtins.check_executables_have_shebangs
  ["symlinks"] = Builtins.check_symlinks
  ["bom"] = Builtins.byte_order_marker
  ["line-endings"] = Builtins.mixed_line_ending
  ["newlines"] = Builtins.newlines
  ["trailing-whitespace"] = Builtins.trailing_whitespace
}

// Keep pre-commit comfortably sub-second for normal C++ edits: only
// staged-file hygiene, deterministic formatters, and cheap orchestration lint.
local fast = new Mapping<String, Step | Group> {
  ...hygiene

  ["clang-format"] = (Builtins.clang_format) {
    glob = cppFiles
  }

  ["nix-format"] {
    glob = "flake.nix"
    check = "nixpkgs-fmt --check {{files}}"
    fix = "nixpkgs-fmt {{files}}"
  }

  ["ruff"] {
    glob = pythonImpact
    check = "uv run --locked ruff check bench benchmarks extensions scripts test tests tools conanfile.py && uv run --locked ruff format --check bench benchmarks extensions scripts test tests tools conanfile.py"
    fix = "uv run --locked ruff check --fix bench benchmarks extensions scripts test tests tools conanfile.py && uv run --locked ruff format bench benchmarks extensions scripts test tests tools conanfile.py"
  }

  ["uv-lock"] {
    glob = List("pyproject.toml", "uv.lock")
    check = "uv lock --check"
    fix = "uv lock"
  }

  ["actionlint"] = Builtins.actionlint

  ["shellcheck"] {
    glob = "scripts/ci/*"
    exclude = "scripts/ci/*.py"
    check = "shellcheck {{files}}"
  }

  ["ci-contracts"] {
    glob = ciImpact
    check = "python3 -m unittest discover -s tools -p 'test_ci*.py'"
  }

  ["just-format"] {
    glob = "justfile"
    check = "just --fmt --check --unstable --justfile justfile"
    fix = "just --fmt --unstable --justfile justfile"
  }

  ["hk-validate"] {
    glob = "hk.pkl"
    check = "hk validate"
  }
}

// Pre-push adds incremental build/test and static analysis. Hook installation
// configures the debug tree first, and the build step refreshes Conan/CMake so
// dependency and build-system edits cannot use stale generated files. Keep the
// build exclusive because Ninja consumes the machine; then fan static analysis
// out across both steps and their affected translation units.
local full = new Mapping<String, Step | Group> {
  ["python-check"] {
    glob = pythonImpact
    check = "scripts/ci/python"
    depends = "ruff"
  }

  ["build-test"] {
    glob = buildImpact
    check = "scripts/ci/configure debug -DFRAME_BUILD_TESTS=ON -DFRAME_BUILD_BENCHMARKS=ON && cmake --build --preset debug && scripts/ci/test debug"
    exclusive = true
  }

  // hk filters checked-out gitlinks as directories before applying globs. This
  // unfiltered guard inspects pre-push refs so a Ghostty-only update still builds.
  ["submodule-build-test"] {
    check = "scripts/ci/submodule-build-test {{files}}"
    stdin = #"{{ hook_stdin | default(value="") }}"#
    depends = "build-test"
  }

  ["clang-tidy"] {
    glob = cppSources
    // The Static Analyzer remains merge-blocking in scripts/ci/lint, but is too expensive for the
    // pre-push feedback path.
    check = "clang-tidy --quiet -p build/debug {{files}}"
    batch = true
    depends = List("build-test", "submodule-build-test")
  }

  ["clangd"] {
    glob = clangdFiles
    // Diagnostics-only check mode avoids the slow and failure-prone per-token code-action tests.
    check = "cmake/check-clangd.sh {{files}}"
    batch = true
    depends = List("build-test", "submodule-build-test")
  }
}

local all = new Mapping<String, Step | Group> {
  ...fast
  ...full
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = fast
  }

  ["pre-push"] { steps = all }

  ["check"] { steps = all }

  ["fix"] {
    fix = true
    steps = fast
  }
}
