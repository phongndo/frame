#!/usr/bin/env bash
set -euo pipefail

readonly mode="${1:-extended}"
readonly output_directory="build/release"
readonly lemma_profiles="${output_directory}/f3-memory-lemma-profiles.json"
readonly tmux_profiles="${output_directory}/f3-memory-tmux-profiles.json"
readonly zellij_profiles="${output_directory}/f3-memory-zellij-profiles.json"
readonly herdr_profiles="${output_directory}/f3-memory-herdr-profiles.json"
readonly session_profiles="${output_directory}/f3-memory-session-profiles.json"
readonly workspace_profiles="${output_directory}/f3-memory-workspace-profiles.json"
readonly components="${output_directory}/f3-memory-components.json"
readonly history="${output_directory}/f3-memory-history.json"
readonly lifecycle="${output_directory}/f3-memory-lifecycle.json"
readonly micro="${output_directory}/f3-memory-microbenchmarks.json"
readonly ownership="${output_directory}/f3-memory-ownership.json"
readonly terminal_ownership="${output_directory}/f3-memory-terminal-ownership.json"
readonly layouts="${output_directory}/f3-memory-record-layouts.txt"
readonly binaries="${output_directory}/f3-memory-binaries.json"
readonly segments="${output_directory}/f3-memory-mach-o-segments.txt"
readonly summary="${output_directory}/f3-memory-summary.json"

case "${mode}" in
  smoke)
    repetitions=1
    lifecycle_cycles=(5)
    summary_churn_cycles=5
    micro_time=0.01s
    micro_repetitions=1
    ;;
  extended)
    repetitions=5
    lifecycle_cycles=(1 10 100)
    summary_churn_cycles=100
    micro_time=0.2s
    micro_repetitions=10
    ;;
  *)
    printf 'usage: %s [smoke|extended]\n' "$0" >&2
    exit 2
    ;;
esac

rm -rf third_party/ghostty/zig-out
scripts/ci/configure release \
  -DLEMMA_BUILD_TESTS=ON \
  -DLEMMA_BUILD_BENCHMARKS=ON \
  -DLEMMA_ENABLE_LATENCY_TRACE=OFF
cmake --build --preset release --target \
  lemma lemma_benchmarks lemma_memory_census lemma_test_server lemma_test_cli \
  lemma_test_pty_peer lemma_benchmark_probe

python3 benchmarks/ownership_census.py \
  --raw-output "${layouts}" \
  --output "${ownership}" >/dev/null
"${output_directory}/lemma_memory_census" >"${terminal_ownership}"
python3 -m json.tool "${terminal_ownership}" >/dev/null
python3 benchmarks/binary_size.py --output "${binaries}" >/dev/null
if [[ "$(uname -s)" == "Darwin" ]]; then
  xcrun size -m "${output_directory}/lemma" "${output_directory}/lemma_test_server" \
    "${output_directory}/lemma_test_cli" >"${segments}"
else
  size -A "${output_directory}/lemma" "${output_directory}/lemma_test_server" \
    "${output_directory}/lemma_test_cli" >"${segments}"
fi

./build/release/lemma_benchmarks \
  --benchmark_min_time="${micro_time}" \
  --benchmark_repetitions="${micro_repetitions}" \
  --benchmark_display_aggregates_only=true \
  --benchmark_out="${micro}" \
  --benchmark_out_format=json >/dev/null
python3 benchmarks/annotate_micro_report.py \
  --report "${micro}" \
  --executable build/release/lemma_benchmarks
python3 benchmarks/mux_benchmark.py \
  --mode profiles \
  --intent "${mode}" \
  --multiplexer lemma \
  --repetitions "${repetitions}" \
  --output "${lemma_profiles}" >/dev/null
python3 benchmarks/validate_report.py --process "${lemma_profiles}"
# Zellij's pane listing slows to seconds per call at high pane counts, so Zellij and Herdr use the
# bounded smoke profile set (still through PMAX) in both modes rather than every scaling knee.
for subject in tmux zellij herdr; do
  profile_output="${output_directory}/f3-memory-${subject}-profiles.json"
  profile_intent="${mode}"
  if [[ "${subject}" != tmux ]]; then
    profile_intent=smoke
  fi
  python3 benchmarks/mux_benchmark.py \
    --mode profiles \
    --intent "${profile_intent}" \
    --multiplexer "${subject}" \
    --repetitions "${repetitions}" \
    --output "${profile_output}" >/dev/null
  python3 benchmarks/validate_report.py --process "${profile_output}"
done
python3 benchmarks/mux_benchmark.py \
  --mode session-profiles \
  --intent "${mode}" \
  --multiplexer lemma \
  --repetitions "${repetitions}" \
  --output "${session_profiles}" >/dev/null
python3 benchmarks/validate_report.py --process "${session_profiles}"
python3 benchmarks/mux_benchmark.py \
  --mode workspace-profiles \
  --intent "${mode}" \
  --multiplexer lemma \
  --repetitions "${repetitions}" \
  --output "${workspace_profiles}" >/dev/null
python3 benchmarks/validate_report.py --process "${workspace_profiles}"
python3 benchmarks/mux_benchmark.py \
  --mode component-resources \
  --intent "${mode}" \
  --multiplexer lemma \
  --repetitions "${repetitions}" \
  --output "${components}" >/dev/null
python3 benchmarks/mux_benchmark.py \
  --mode history-resources \
  --intent "${mode}" \
  --multiplexer lemma \
  --repetitions "${repetitions}" \
  --output "${history}" >/dev/null
for churn_cycles in "${lifecycle_cycles[@]}"; do
  lifecycle_output="${output_directory}/f3-memory-lifecycle-${churn_cycles}.json"
  if ((churn_cycles == summary_churn_cycles)); then
    lifecycle_output="${lifecycle}"
  fi
  python3 benchmarks/mux_benchmark.py \
    --mode lifecycle-churn \
    --intent "${mode}" \
    --multiplexer lemma \
    --repetitions "${churn_cycles}" \
    --output "${lifecycle_output}" >/dev/null
  python3 benchmarks/validate_report.py --process "${lifecycle_output}"
done
python3 benchmarks/summarize_memory.py \
  --lemma-profiles "${lemma_profiles}" \
  --tmux-profiles "${tmux_profiles}" \
  --zellij-profiles "${zellij_profiles}" \
  --herdr-profiles "${herdr_profiles}" \
  --components "${components}" \
  --history "${history}" \
  --lifecycle "${lifecycle}" \
  --output "${summary}" >/dev/null

printf 'F3 memory evidence: %s\n' "${summary}"
