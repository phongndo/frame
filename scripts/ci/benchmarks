#!/usr/bin/env bash
set -euo pipefail

readonly mode="${1:-smoke}"
readonly manifest="benchmarks/workloads.json"
readonly output="build/release/benchmark-results.json"
readonly mux_output="build/release/mux-benchmark-results.json"
readonly comparison_output="build/release/mux-comparison-results.json"
readonly profile_output="build/release/mux-profile-results.json"

case "${mode}" in
  smoke | extended) ;;
  *)
    printf 'usage: %s [smoke|extended]\n' "$0" >&2
    exit 2
    ;;
esac

read -r micro_repetitions process_repetitions profile_repetitions micro_time warmup_time < <(
  python3 - "${manifest}" "${mode}" <<'PY'
import json
import sys
policy = json.load(open(sys.argv[1], encoding="utf-8"))["sample_policies"][sys.argv[2]]
print(
    policy["micro_repetitions"],
    policy["process_repetitions"],
    policy["profile_repetitions"],
    f'{policy["micro_min_time_seconds"]}s',
    policy["micro_warmup_seconds"],
)
PY
)

cleanup_ghostty_output() {
  rm -rf third_party/ghostty/zig-out
}
trap cleanup_ghostty_output EXIT

python3 - <<'PY'
from benchmarks.benchmark_manifest import load_manifest
load_manifest()
PY
python3 benchmarks/check_regression.py --validate-manifest
python3 benchmarks/benchmark_tools_test.py >/dev/null

rm -rf third_party/ghostty/zig-out
scripts/ci/configure release \
  -DFRAME_BUILD_TESTS=OFF \
  -DFRAME_BUILD_BENCHMARKS=ON \
  -DFRAME_ENABLE_LATENCY_TRACE=OFF
cmake --build --preset release --target \
  frame_benchmarks frame_test_server frame_test_cli frame_test_pty_peer \
  frame_benchmark_probe
./build/release/frame_benchmark_probe --self-test

micro_command=(
  ./build/release/frame_benchmarks
  "--benchmark_min_time=${micro_time}"
  "--benchmark_min_warmup_time=${warmup_time}"
  "--benchmark_repetitions=${micro_repetitions}"
  --benchmark_enable_random_interleaving=true
  --benchmark_display_aggregates_only=true
  "--benchmark_out=${output}"
  --benchmark_out_format=json
)
rm -f "${output}"
"${micro_command[@]}"
python3 benchmarks/annotate_micro_report.py \
  --report "${output}" \
  --executable build/release/frame_benchmarks \
  --manifest "${manifest}" \
  --command "${micro_command[@]}"
python3 benchmarks/validate_report.py --manifest "${manifest}" --micro "${output}"

rm -f "${mux_output}"
python3 benchmarks/mux_benchmark.py \
  --manifest "${manifest}" \
  --mode comparison \
  --intent "${mode}" \
  --multiplexer frame \
  --repetitions "${process_repetitions}" \
  --output "${mux_output}" >/dev/null
python3 benchmarks/validate_report.py --manifest "${manifest}" --process "${mux_output}"

rm -f "${profile_output}"
python3 benchmarks/mux_benchmark.py \
  --manifest "${manifest}" \
  --mode profiles \
  --intent "${mode}" \
  --multiplexer frame \
  --repetitions "${profile_repetitions}" \
  --output "${profile_output}" >/dev/null
python3 benchmarks/validate_report.py --manifest "${manifest}" --process "${profile_output}"

rm -f "${comparison_output}"
python3 benchmarks/compare_mux.py \
  --manifest "${manifest}" \
  --intent "${mode}" \
  --repetitions "${process_repetitions}" \
  --output "${comparison_output}" >/dev/null
python3 benchmarks/validate_report.py \
  --manifest "${manifest}" \
  --comparison "${comparison_output}" \
  --allow-failures

printf 'benchmark reports:\n  %s\n  %s\n  %s\n  %s\n' \
  "${output}" "${mux_output}" "${profile_output}" "${comparison_output}"
