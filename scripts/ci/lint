#!/usr/bin/env bash
set -euo pipefail

scripts/ci/configure debug \
  -DFRAME_BUILD_TESTS=ON \
  -DFRAME_BUILD_BENCHMARKS=ON
# Prepare generated includes without building the application.
cmake --build --preset debug --target frame_analysis_inputs

# The default config omits the expensive Static Analyzer from interactive and pre-push linting.
# Keep it merge-blocking here, where this lane runs independently from developer feedback.
find apps src tests benchmarks -type f -name '*.cpp' -print0 |
  xargs -0 -n 1 -P "${CLANG_TIDY_JOBS:-4}" \
    clang-tidy --quiet '-checks=clang-analyzer-*' -p build/debug
