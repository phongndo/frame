#!/usr/bin/env bash
set -euo pipefail

readonly profile="${FRAME_TEST_PROFILE:-debug}"
readonly seed_count="${FRAME_MUX_CAMPAIGN_SEEDS:-64}"
readonly operations="${FRAME_MUX_CAMPAIGN_OPERATIONS:-16384}"
readonly artifact_dir="build/${profile}/mux-sim-artifacts"
readonly binary="./build/${profile}/frame_core_sim_tests"

if [[ ! "${seed_count}" =~ ^[1-9][0-9]*$ ]]; then
  printf 'FRAME_MUX_CAMPAIGN_SEEDS must be a positive integer\n' >&2
  exit 2
fi
if [[ ! "${operations}" =~ ^[1-9][0-9]*$ ]] || ((operations > 16384)); then
  printf 'FRAME_MUX_CAMPAIGN_OPERATIONS must be in [1, 16384]\n' >&2
  exit 2
fi

scripts/ci/configure "${profile}" \
  -DFRAME_BUILD_TESTS=ON \
  -DFRAME_BUILD_BENCHMARKS=OFF
cmake --build "build/${profile}" --target frame_core_sim_tests
rm -rf "${artifact_dir}"
mkdir -p "${artifact_dir}"
{
  printf 'source_commit=%s\n' "$(git rev-parse HEAD)"
  printf 'source_tree=%s\n' "$(git rev-parse 'HEAD^{tree}')"
  printf 'index_tree=%s\n' "$(git write-tree)"
  printf 'system=%s\nseed_count=%s\noperations=%s\n' "$(uname -a)" "${seed_count}" "${operations}"
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "${binary}"
  else
    shasum -a 256 "${binary}"
  fi
  clang++ --version
} >"${artifact_dir}/campaign.provenance.txt"

"${binary}" \
  --gtest_filter=MuxSimulationTest.ReplaysCheckedInCorpus \
  --gtest_brief=1

for ((index = 0; index < seed_count; ++index)); do
  seed="$(od -An -N8 -tu8 /dev/urandom | tr -d '[:space:]')"
  trace="${artifact_dir}/mux-${seed}.trace"
  coverage="${artifact_dir}/mux-${seed}.coverage.json"
  diagnostics="${artifact_dir}/mux-${seed}.log"
  printf 'mux simulation campaign %s/%s seed=%s operations=%s\n' \
    "$((index + 1))" "${seed_count}" "${seed}" "${operations}"
  {
    printf '%q ' env FRAME_MUX_SIM_SEED="${seed}" \
      FRAME_MUX_SIM_OPERATIONS="${operations}" FRAME_MUX_SIM_TRACE_OUT="${trace}" \
      FRAME_MUX_SIM_COVERAGE_OUT="${coverage}" "${binary}" \
      --gtest_filter=MuxSimulationTest.GeneratedCommandsAndRuntimeFaultsPreserveAllInvariants \
      --gtest_brief=1
    printf '\n'
  } >>"${artifact_dir}/campaign.commands.txt"
  if ! FRAME_MUX_SIM_SEED="${seed}" \
    FRAME_MUX_SIM_OPERATIONS="${operations}" \
    FRAME_MUX_SIM_TRACE_OUT="${trace}" \
    FRAME_MUX_SIM_COVERAGE_OUT="${coverage}" \
    "${binary}" \
    --gtest_filter=MuxSimulationTest.GeneratedCommandsAndRuntimeFaultsPreserveAllInvariants \
    --gtest_brief=1 2>&1 | tee "${diagnostics}"; then
    printf 'replay artifacts retained under %s\n' "${artifact_dir}" >&2
    exit 1
  fi
  rm -f "${trace}" "${diagnostics}"
done
