#!/usr/bin/env bash
set -euo pipefail

readonly micro_output="build/release/regression-microbenchmarks.json"
readonly process_output="build/release/regression-process-workloads.json"
readonly profile_output="build/release/regression-pane-profiles.json"
readonly result_output="build/release/regression-budget-results.json"
readonly manifest="benchmarks/workloads.json"

read -r micro_repetitions process_repetitions profile_repetitions micro_time warmup_time micro_filter < <(
  python3 - "${manifest}" <<'PY'
import json
import sys
manifest = json.load(open(sys.argv[1], encoding="utf-8"))
policy = manifest["sample_policies"]["gate"]
benchmarks = [check["benchmark"] for check in manifest["regression_budgets"]["microbenchmarks"]["checks"]]
print(
    policy["micro_repetitions"],
    policy["process_repetitions"],
    policy["profile_repetitions"],
    f'{policy["micro_min_time_seconds"]}s',
    policy["micro_warmup_seconds"],
    '^(' + '|'.join(benchmarks) + ')$',
)
PY
)

cleanup_ghostty_output() {
  rm -rf third_party/ghostty/zig-out
}
trap cleanup_ghostty_output EXIT

python3 benchmarks/check_regression.py --validate-manifest
python3 benchmarks/benchmark_tools_test.py >/dev/null

rm -rf third_party/ghostty/zig-out
scripts/ci/configure release \
  -DLEMMA_BUILD_TESTS=OFF \
  -DLEMMA_BUILD_BENCHMARKS=ON \
  -DLEMMA_ENABLE_LATENCY_TRACE=OFF
cmake --build --preset release --target \
  lemma_benchmarks lemma_test_server lemma_test_cli lemma_test_pty_peer \
  lemma_benchmark_probe
./build/release/lemma_benchmark_probe --self-test

# Do not benchmark immediately after the ReleaseFast archive and C++ targets heat the host.
sleep 30

rm -f "${micro_output}" "${process_output}" "${profile_output}" "${result_output}"
./build/release/lemma_benchmarks \
  --benchmark_filter="${micro_filter}" \
  --benchmark_min_time="${micro_time}" \
  --benchmark_min_warmup_time="${warmup_time}" \
  --benchmark_repetitions="${micro_repetitions}" \
  --benchmark_enable_random_interleaving=true \
  --benchmark_display_aggregates_only=true \
  --benchmark_out="${micro_output}" \
  --benchmark_out_format=json >/dev/null
python3 benchmarks/annotate_micro_report.py \
  --report "${micro_output}" \
  --executable build/release/lemma_benchmarks
python3 benchmarks/validate_report.py --micro "${micro_output}"
python3 benchmarks/mux_benchmark.py \
  --mode regression \
  --intent gate \
  --repetitions "${process_repetitions}" \
  --output "${process_output}" >/dev/null
python3 benchmarks/validate_report.py --process "${process_output}"
python3 benchmarks/mux_benchmark.py \
  --mode profiles \
  --intent gate \
  --repetitions "${profile_repetitions}" \
  --output "${profile_output}" >/dev/null
python3 benchmarks/validate_report.py --process "${profile_output}"
python3 benchmarks/check_regression.py \
  --micro-report "${micro_output}" \
  --process-report "${process_output}" \
  --profile-report "${profile_output}" \
  --output "${result_output}" >/dev/null

printf 'regression budgets passed; report: %s\n' "${result_output}"
