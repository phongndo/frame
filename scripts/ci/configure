#!/usr/bin/env bash
set -euo pipefail

if (( $# < 1 )); then
  printf 'usage: %s <dev|debug|release|sanitizers> [cmake options ...]\n' "$0" >&2
  exit 2
fi

readonly profile="$1"
shift

case "${profile}" in
  dev)
    readonly build_type="Dev"
    readonly conan_build_type="Release"
    ;;
  debug | sanitizers)
    readonly build_type="Debug"
    readonly conan_build_type="Debug"
    ;;
  release)
    readonly build_type="Release"
    readonly conan_build_type="Release"
    ;;
  *)
    printf 'unsupported CMake profile: %s\n' "${profile}" >&2
    exit 2
    ;;
esac

# Project presets point at Conan's toolchain directly; suppressing the generated
# root user preset avoids duplicate `conan-debug` names across isolated trees.
rm -f CMakeUserPresets.json
conan install . \
  --lockfile=conan.lock \
  --output-folder="build/${profile}/conan" \
  --profile:all=conan/profiles/llvm \
  --settings="build_type=${conan_build_type}" \
  --conf="tools.cmake.cmaketoolchain:user_presets=" \
  --build=missing

cmake_ghostty_args=()
if [[ -n "${FRAME_GHOSTTY_SOURCE_DIR:-}" ]]; then
  cmake_ghostty_args+=(
    "-DFRAME_GHOSTTY_SOURCE_DIR=${FRAME_GHOSTTY_SOURCE_DIR}"
    "-DFRAME_GHOSTTY_NIX_SOURCE_REV=${FRAME_GHOSTTY_NIX_SOURCE_REV:-}"
  )
fi
if [[ -n "${FRAME_GHOSTTY_ZIG_SYSTEM_DIR:-}" ]]; then
  cmake_ghostty_args+=("-DFRAME_GHOSTTY_ZIG_SYSTEM_DIR=${FRAME_GHOSTTY_ZIG_SYSTEM_DIR}")
fi

cmake --preset "${profile}" \
  -DCMAKE_BUILD_TYPE="${build_type}" \
  -DCMAKE_TOOLCHAIN_FILE="${PWD}/build/${profile}/conan/conan_toolchain.cmake" \
  ${cmake_ghostty_args[@]+"${cmake_ghostty_args[@]}"} \
  "$@"
