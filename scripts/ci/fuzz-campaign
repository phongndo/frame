#!/usr/bin/env bash
set -euo pipefail

if [[ "$(uname -s)" != Linux ]]; then
  printf 'scheduled mutation fuzzing requires Linux libFuzzer\n' >&2
  exit 2
fi

readonly seconds_per_target="${FRAME_FUZZ_CAMPAIGN_SECONDS_PER_TARGET:-300}"
if [[ ! "${seconds_per_target}" =~ ^[1-9][0-9]*$ ]] || ((seconds_per_target > 3600)); then
  printf 'FRAME_FUZZ_CAMPAIGN_SECONDS_PER_TARGET must be in [1, 3600]\n' >&2
  exit 2
fi

rm -rf third_party/ghostty/zig-out build/sanitizers/fuzz-campaign
scripts/ci/validate-fuzz-corpus.py
scripts/ci/configure sanitizers \
  -DFRAME_BUILD_TESTS=OFF \
  -DFRAME_BUILD_BENCHMARKS=OFF \
  -DFRAME_BUILD_FUZZERS=ON
cmake --build --preset sanitizers --target \
  frame_attachment_decoder_fuzz frame_host_input_parser_fuzz frame_api_json_fuzz \
  frame_extension_framing_fuzz

readonly root="build/sanitizers/fuzz-campaign"
mkdir -p "${root}"/{work,artifacts}/{attachment,host-input,api,extension}
cp -R fuzz/corpus/attachment/. "${root}/work/attachment/"
cp -R fuzz/corpus/host-input/. "${root}/work/host-input/"
cp -R fuzz/corpus/api/. "${root}/work/api/"
cp -R fuzz/corpus/extension/. "${root}/work/extension/"

run_target() {
  local binary="$1"
  local domain="$2"
  local dictionary="$3"
  "${binary}" \
    "-max_total_time=${seconds_per_target}" \
    -timeout=10 \
    -rss_limit_mb=4096 \
    "-dict=${dictionary}" \
    "-artifact_prefix=${root}/artifacts/${domain}/" \
    "${root}/work/${domain}"
}

run_target ./build/sanitizers/frame_attachment_decoder_fuzz attachment \
  fuzz/dictionaries/attachment.dict
run_target ./build/sanitizers/frame_host_input_parser_fuzz host-input \
  fuzz/dictionaries/host-input.dict
run_target ./build/sanitizers/frame_api_json_fuzz api fuzz/dictionaries/api-json.dict
run_target ./build/sanitizers/frame_extension_framing_fuzz extension fuzz/dictionaries/extension.dict

printf 'scheduled fuzz campaign completed; evidence: %s\n' "${root}"
