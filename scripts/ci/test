#!/usr/bin/env bash
set -euo pipefail

if (( $# != 1 )); then
  printf 'usage: %s <debug|release|sanitizers>\n' "$0" >&2
  exit 2
fi

readonly profile="$1"
# CMake registers this unlabeled sentinel when a discovered GTest binary has not been built. The
# platform lane intentionally does not build extended binaries, so exclude only their sentinels;
# a missing fast-suite binary must still fail loudly.
readonly unbuilt_extended_tests='^frame_(terminal_resource|core_sim|protocol_sim|terminal_sim)_tests_NOT_BUILT$'

# Cheap native tests run in parallel. Real process tests intentionally run one at a time:
# each creates PTYs, sockets, and subprocesses, and host contention can obscure the contract.
# Stress, allocation, and long resource sweeps are explicit.
ctest --preset "${profile}" --no-tests=error -LE 'integration|extended' \
  -E "${unbuilt_extended_tests}" --parallel "${CTEST_PARALLEL_LEVEL:-4}"
ctest --preset "${profile}" --no-tests=error -L integration -LE extended \
  -E "${unbuilt_extended_tests}" --parallel 1
