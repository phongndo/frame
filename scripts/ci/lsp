#!/usr/bin/env bash
set -euo pipefail

scripts/ci/configure debug \
  -DFRAME_BUILD_TESTS=ON \
  -DFRAME_BUILD_BENCHMARKS=OFF
# Prepare generated includes without building the application.
cmake --build --preset debug --target frame_analysis_inputs

# check-clangd.sh disables per-token feature tests and promotes all emitted warnings to failures, so
# this lane can validate every production source/header without exercising hover and code actions.
find apps include src -type f \( -name '*.hpp' -o -name '*.cpp' \) -print0 |
  sort -z |
  xargs -0 -n 1 -P "${CLANGD_JOBS:-4}" cmake/check-clangd.sh
