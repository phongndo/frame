#!/usr/bin/env bash
set -euo pipefail

# Keep sanitizer flags and objects out of the ordinary debug cache so running
# this suite locally cannot change later `just build` or hook behavior. Ghostty's wrapper shares one
# source-tree output across profiles, so force the Debug archive required by this lane.
rm -rf third_party/ghostty/zig-out
scripts/ci/validate-fuzz-corpus.py
scripts/ci/configure sanitizers \
  -DFRAME_BUILD_TESTS=ON \
  -DFRAME_BUILD_BENCHMARKS=OFF \
  -DFRAME_BUILD_FUZZERS=ON
cmake --build --preset sanitizers --target \
  frame \
  frame_fast_test_binaries \
  frame_core_sim_tests \
  frame_protocol_sim_tests \
  frame_terminal_sim_tests \
  frame_terminal_resource_tests \
  frame_steady_state_allocation_audit \
  frame_attachment_decoder_fuzz \
  frame_host_input_parser_fuzz \
  frame_api_json_fuzz \
  frame_extension_framing_fuzz

leak_detection=1
if [[ "$(uname -s)" == Darwin ]]; then
  # Apple's ASan runtime does not implement LeakSanitizer. The merge-blocking
  # Linux lane below keeps leak detection mandatory.
  leak_detection=0
fi
export ASAN_OPTIONS="detect_leaks=${leak_detection}:strict_string_checks=1"
export UBSAN_OPTIONS="print_stacktrace=1:halt_on_error=1"
scripts/ci/test sanitizers
ctest --preset sanitizers --no-tests=error -L extended --parallel 1
scripts/ci/deterministic-budgets sanitizers
if [[ "$(uname -s)" == Linux ]]; then
  readonly fuzz_seconds="${FRAME_FUZZ_SECONDS_PER_TARGET:-10}"
  mkdir -p build/sanitizers/fuzz-work/{attachment,host-input,api,extension} \
    build/sanitizers/fuzz-artifacts/{attachment,host-input,api,extension}
  ./build/sanitizers/frame_attachment_decoder_fuzz \
    "-max_total_time=${fuzz_seconds}" \
    -dict=fuzz/dictionaries/attachment.dict \
    -artifact_prefix=build/sanitizers/fuzz-artifacts/attachment/ \
    build/sanitizers/fuzz-work/attachment fuzz/corpus/attachment
  ./build/sanitizers/frame_host_input_parser_fuzz \
    "-max_total_time=${fuzz_seconds}" \
    -dict=fuzz/dictionaries/host-input.dict \
    -artifact_prefix=build/sanitizers/fuzz-artifacts/host-input/ \
    build/sanitizers/fuzz-work/host-input fuzz/corpus/host-input
  ./build/sanitizers/frame_api_json_fuzz \
    "-max_total_time=${fuzz_seconds}" \
    -dict=fuzz/dictionaries/api-json.dict \
    -artifact_prefix=build/sanitizers/fuzz-artifacts/api/ \
    build/sanitizers/fuzz-work/api fuzz/corpus/api
  ./build/sanitizers/frame_extension_framing_fuzz \
    "-max_total_time=${fuzz_seconds}" \
    -dict=fuzz/dictionaries/extension.dict \
    -artifact_prefix=build/sanitizers/fuzz-artifacts/extension/ \
    build/sanitizers/fuzz-work/extension fuzz/corpus/extension
else
  ./build/sanitizers/frame_extension_framing_fuzz -runs=0 fuzz/corpus/extension
  ./build/sanitizers/frame_attachment_decoder_fuzz -runs=0 fuzz/corpus/attachment
  ./build/sanitizers/frame_host_input_parser_fuzz -runs=0 fuzz/corpus/host-input
  ./build/sanitizers/frame_api_json_fuzz -runs=0 fuzz/corpus/api
fi

# Select the stress seed outside the test process so a sanitizer crash cannot lose its replay
# identity. An explicit override reproduces a reported history; otherwise every run gets a new
# seed. The operation count, rather than wall time, keeps this merge-blocking run bounded.
if [[ -n "${FRAME_MUX_SIM_SEED:-}" ]]; then
  mux_seed="${FRAME_MUX_SIM_SEED}"
else
  mux_seed="$(od -An -N8 -tu8 /dev/urandom | tr -d '[:space:]')"
fi
readonly mux_seed
readonly mux_operations="${FRAME_MUX_SIM_OPERATIONS:-16384}"
if [[ ! "${mux_seed}" =~ ^(0[xX][0-9a-fA-F]+|[0-9]+)$ ]]; then
  printf 'FRAME_MUX_SIM_SEED must be an unsigned decimal or hexadecimal integer\n' >&2
  exit 2
fi
if [[ ! "${mux_operations}" =~ ^[1-9][0-9]*$ ]] || ((10#${mux_operations} > 16384)); then
  printf 'FRAME_MUX_SIM_OPERATIONS must be in [1, 16384]\n' >&2
  exit 2
fi
readonly mux_artifact_dir="build/sanitizers/mux-sim-artifacts"
readonly mux_trace="${mux_artifact_dir}/mux-${mux_seed}.trace"
readonly mux_coverage="${mux_artifact_dir}/mux-${mux_seed}.coverage.json"
readonly mux_diagnostics="${mux_artifact_dir}/mux-${mux_seed}.log"
readonly mux_provenance="${mux_artifact_dir}/mux-${mux_seed}.provenance.txt"
mkdir -p "${mux_artifact_dir}"
{
  printf 'source_commit=%s\n' "$(git rev-parse HEAD)"
  printf 'source_tree=%s\n' "$(git rev-parse 'HEAD^{tree}')"
  printf 'index_tree=%s\n' "$(git write-tree)"
  printf 'system=%s\n' "$(uname -a)"
  printf 'seed=%s\noperations=%s\n' "${mux_seed}" "${mux_operations}"
  printf 'ASAN_OPTIONS=%s\nUBSAN_OPTIONS=%s\n' "${ASAN_OPTIONS}" "${UBSAN_OPTIONS}"
  printf 'command='
  printf '%q ' env FRAME_MUX_SIM_SEED="${mux_seed}" \
    FRAME_MUX_SIM_OPERATIONS="${mux_operations}" FRAME_MUX_SIM_TRACE_OUT="${mux_trace}" \
    FRAME_MUX_SIM_COVERAGE_OUT="${mux_coverage}" \
    ./build/sanitizers/frame_core_sim_tests \
    --gtest_filter=MuxSimulationTest.GeneratedCommandsAndRuntimeFaultsPreserveAllInvariants \
    --gtest_brief=1
  printf '\n'
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum ./build/sanitizers/frame_core_sim_tests
  else
    shasum -a 256 ./build/sanitizers/frame_core_sim_tests
  fi
  clang++ --version
} >"${mux_provenance}"
printf 'deterministic mux stress seed: %s (operations=%s)\n' "${mux_seed}" "${mux_operations}"
set +e
FRAME_MUX_SIM_SEED="${mux_seed}" FRAME_MUX_SIM_OPERATIONS="${mux_operations}" \
  FRAME_MUX_SIM_TRACE_OUT="${mux_trace}" \
  FRAME_MUX_SIM_COVERAGE_OUT="${mux_coverage}" \
  ./build/sanitizers/frame_core_sim_tests \
  --gtest_filter=MuxSimulationTest.GeneratedCommandsAndRuntimeFaultsPreserveAllInvariants \
  --gtest_brief=1 2>&1 | tee "${mux_diagnostics}"
mux_status="${PIPESTATUS[0]}"
set -e
if ((mux_status != 0)); then
  printf 'mux simulation failed; evidence retained under %s\n' "${mux_artifact_dir}" >&2
  exit "${mux_status}"
fi
rm -f "${mux_trace}" "${mux_diagnostics}"

./build/sanitizers/frame --help >/dev/null
