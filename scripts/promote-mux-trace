#!/usr/bin/env bash
set -euo pipefail

if (($# != 3)); then
  printf 'usage: scripts/promote-mux-trace TRACE CORPUS_NAME REGRESSION\n' >&2
  exit 2
fi

readonly source_trace="$1"
if [[ ! -f "${source_trace}" ]]; then
  printf 'mux trace does not exist: %s\n' "${source_trace}" >&2
  exit 2
fi

name="$2"
name="${name%.min.trace}"
name="${name%.trace}"
if [[ ! "${name}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  printf 'invalid corpus name: %s\n' "${name}" >&2
  exit 2
fi
readonly regression="$3"
if [[ -z "${regression}" || "${regression}" == *$'\n'* || "${regression}" == *$'\r'* ]]; then
  printf 'REGRESSION must be one non-empty line\n' >&2
  exit 2
fi
source_revision="$(git rev-parse HEAD)"
readonly source_revision

readonly profile="${FRAME_TEST_PROFILE:-debug}"
readonly binary="./build/${profile}/frame_core_sim_tests"
readonly destination="tests/sim/corpus/mux/${name}.trace"

scripts/ci/configure "${profile}" \
  -DFRAME_BUILD_TESTS=ON \
  -DFRAME_BUILD_BENCHMARKS=OFF
cmake --build "build/${profile}" --target frame_core_sim_tests
mkdir -p "build/${profile}" "$(dirname "${destination}")"
temporary="$(mktemp "build/${profile}/mux-promote.XXXXXX")"
readonly temporary
trap 'rm -f "${temporary}"' EXIT

FRAME_MUX_SIM_TRACE="${source_trace}" \
  FRAME_MUX_SIM_TRACE_OUT="${temporary}" \
  FRAME_MUX_SIM_REFRESH_TRACE=1 \
  "${binary}" \
  --gtest_filter=MuxSimulationTest.GeneratedCommandsAndRuntimeFaultsPreserveAllInvariants \
  --gtest_brief=1
python3 - "${temporary}" "${source_trace}" "${source_revision}" "${regression}" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
source = sys.argv[2]
revision = sys.argv[3]
regression = sys.argv[4]
lines = path.read_text(encoding="utf-8").splitlines()
if not lines or lines[0] != "frame-mux-trace-v1":
    raise SystemExit("refreshed trace has no supported header")
metadata = [
    lines[0],
    "# corpus-kind: regression",
    f"# description: {regression}",
    f"# source-trace: {source}",
    f"# fixed-at: {revision}",
]
metadata_prefixes = (
    "# corpus-kind:", "# description:", "# regression:",
    "# source-trace:", "# introduced-at:", "# fixed-at:",
)
body = [line for line in lines[1:] if not line.startswith(metadata_prefixes)]
path.write_text("\n".join([*metadata, *body]) + "\n", encoding="utf-8")
PY
mv "${temporary}" "${destination}"
printf 'promoted mux regression trace: %s\n' "${destination}"
