+
+/// Free a retained read, without issuing any further response. Call before terminal destruction.
+pub fn clipboard_read_free(request: ?*const ClipboardRead) callconv(lib.calling_conv) void {
+    const value = request orelse return;
+    const saved: *DeferredClipboardRead = @fieldParentPtr("request", @constCast(value));
+    const gpa = saved.ctx.wrapper.terminal.gpa();
+    saved.arena.deinit();
+    gpa.destroy(saved);
+}
+
+pub fn clipboard_write_defer(request: ?*const ClipboardWrite, out: ?*?*const ClipboardWrite) callconv(lib.calling_conv) Result {
+    const source = request orelse return .invalid_value;
+    const destination = out orelse return .invalid_value;
+    destination.* = null;
+    const ctx: *Effects.ClipboardWriteCtx = @ptrCast(@alignCast(@constCast(source.ctx)));
+    if (ctx.claimed or ctx.retained) return .invalid_value;
+    const clone = ctx.write.defer_reply orelse return .invalid_value;
+    const gpa = ctx.wrapper.terminal.gpa();
+    const saved = gpa.create(DeferredClipboardWrite) catch return .out_of_memory;
+    saved.* = .{ .arena = .init(gpa), .ctx = ctx.*, .request = source.* };
+    const arena = saved.arena.allocator();
+    const result = retain: {
+        saved.request.name = .init(arena.dupe(u8, source.name.ptr[0..source.name.len]) catch break :retain Result.out_of_memory);
+        const contents = arena.alloc(ClipboardContent, source.contents_len) catch break :retain Result.out_of_memory;
+        if (source.contents) |ptr| for (contents, ptr[0..source.contents_len]) |*to, from| {
+            to.* = .{
+                .mime = .init(arena.dupe(u8, from.mime.ptr[0..from.mime.len]) catch break :retain Result.out_of_memory),
