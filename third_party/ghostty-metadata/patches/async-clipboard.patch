+/// Retain only during the callback, before replying. The terminal must outlive the result.
+pub fn clipboard_read_defer(request: ?*const ClipboardRead, out: ?*?*const ClipboardRead) callconv(lib.calling_conv) Result {
+    const source = request orelse return .invalid_value;
+    const destination = out orelse return .invalid_value;
+    destination.* = null;
+    const ctx: *Effects.ClipboardReadCtx = @ptrCast(@alignCast(@constCast(source.ctx)));
+    if (ctx.claimed or ctx.retained) return .invalid_value;
+    const clone = ctx.read.defer_reply orelse return .invalid_value;
+    const gpa = ctx.wrapper.terminal.gpa();
+    const saved = gpa.create(DeferredClipboardRead) catch return .out_of_memory;
+    saved.* = .{ .arena = .init(gpa), .ctx = ctx.*, .request = source.* };
+    const arena = saved.arena.allocator();
+    const result = retain: {
+        saved.request.name = .init(arena.dupe(u8, source.name.ptr[0..source.name.len]) catch break :retain Result.out_of_memory);
+        const mimes = arena.alloc(lib.String, source.mimes_len) catch break :retain Result.out_of_memory;
+        if (source.mimes) |ptr| for (mimes, ptr[0..source.mimes_len]) |*to, from| {
+            to.* = .init(arena.dupe(u8, from.ptr[0..from.len]) catch break :retain Result.out_of_memory);
+        };
+        saved.request.mimes = mimes.ptr;
+        saved.ctx.read.reply_ctx = clone(ctx.read.reply_ctx, arena) catch break :retain Result.out_of_memory;
