+        saved.ctx.write.reply_ctx = clone(ctx.write.reply_ctx, arena) catch break :retain Result.out_of_memory;
+        break :retain Result.success;
+    };
+    if (result != .success) {
+        saved.arena.deinit();
+        gpa.destroy(saved);
+        return result;
+    }
+    ctx.claimed = true;
+    saved.ctx.retained = true;
+    saved.request.ctx = &saved.ctx;
+    destination.* = &saved.request;
+    return .success;
+}
+
+pub fn clipboard_write_free(request: ?*const ClipboardWrite) callconv(lib.calling_conv) void {
+    const value = request orelse return;
+    const saved: *DeferredClipboardWrite = @fieldParentPtr("request", @constCast(value));
+    const gpa = saved.ctx.wrapper.terminal.gpa();
+    saved.arena.deinit();
+    gpa.destroy(saved);
+}
