---
# Keep interactive and pre-push lint responsive. The merge-blocking CI lint lane
# explicitly adds clang-analyzer-* back for the slower path-sensitive analysis.
Checks: >
  bugprone-*,
  cert-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-owning-memory,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers
WarningsAsErrors: '*'
HeaderFilterRegex: '(^|/)(include|src|tests|benchmarks)/'
FormatStyle: file
SystemHeaders: false
CheckOptions:
  # Standard-library contract violations (for example string_view::substr past the end) terminate
  # inside noexcept code. libc++ defines its throw helpers inline, so only Darwin exposes them.
  bugprone-exception-escape.IgnoredExceptions: 'out_of_range,length_error,bad_array_new_length'
  readability-function-cognitive-complexity.Threshold: '15'
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.FunctionCase: lower_case
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
...
