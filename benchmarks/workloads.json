  "process_workloads": [
    {
      "id": "warm_scroll",
      "input": "one trigger to a persistent fixture that emits 25000 79-column CRLF rows followed by a unique completion marker",
      "completion": "the completion marker is observable in the attached client output",
      "metrics": [
        "latency_ns",
        "outer_bytes"
      ],
      "cli_mode": "warm-scroll",
      "fixture": "warm-scroll",
